{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                mc.asset_id,\n                a.symbol,\n                mc.timeframe,\n                mc.timestamp,\n                mc.trend_state,\n                mc.volatility_regime,\n                mc.market_phase,\n                mc.ema_20,\n                mc.ema_50,\n                mc.sma_200,\n                mc.atr_14,\n                mc.atr_percent_14,\n                mc.volume_relative,\n                mc.hh_hl_count,\n                mc.lh_ll_count,\n                mc.range_percent,\n                mc.is_tradeable,\n                mc.raw_values as \"raw_values!: serde_json::Value\"\n            FROM market_contexts mc\n            JOIN assets a ON a.id = mc.asset_id\n            WHERE a.symbol = $1 AND mc.timeframe = $2 AND mc.timestamp >= $3 AND mc.timestamp <= $4\n            ORDER BY mc.timestamp ASC\n            ",
