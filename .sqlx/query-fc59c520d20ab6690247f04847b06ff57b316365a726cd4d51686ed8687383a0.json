  "query": "\n            SELECT\n                t.id,\n                a.symbol,\n                t.signal_id,\n                t.position_id,\n                t.direction,\n                t.entry_price,\n                t.exit_price,\n                t.quantity,\n                t.entry_time,\n                t.exit_time,\n                t.stop_price,\n                t.target_price,\n                t.gross_pnl,\n                t.commissions,\n                t.fees,\n                t.net_pnl,\n                t.risk_amount,\n                t.result_in_r,\n                t.exit_reason,\n                t.strategy_id,\n                t.strategy_version,\n                t.config_hash,\n                t.journal as \"journal!: serde_json::Value\",\n                t.correlation_id\n            FROM trades t\n            JOIN assets a ON a.id = t.asset_id\n            WHERE t.id = $1\n            ",
