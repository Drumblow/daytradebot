  "query": "\n            SELECT\n                f.id,\n                f.order_id,\n                a.symbol,\n                f.side,\n                f.fill_price,\n                f.quantity,\n                f.commission,\n                f.fees,\n                f.broker_fill_id,\n                f.timestamp\n            FROM fills f\n            JOIN assets a ON a.id = f.asset_id\n            WHERE f.order_id = $1\n            ORDER BY f.timestamp ASC\n            ",
