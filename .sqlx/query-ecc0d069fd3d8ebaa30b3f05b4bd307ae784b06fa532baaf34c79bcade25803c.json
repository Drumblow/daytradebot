{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                r.id,\n                a.symbol,\n                r.strategy_version,\n                r.config_hash,\n                r.timeframe,\n                r.period_start,\n                r.period_end,\n                r.final_equity,\n                r.metrics as \"metrics!: serde_json::Value\",\n                r.label,\n                r.created_at\n            FROM backtest_runs r\n            JOIN assets a ON a.id = r.asset_id\n            WHERE r.strategy_id = $1\n            ORDER BY r.created_at DESC\n            LIMIT 1\n            ",
